{
  "openapi": "3.1.0",
  "info": {
    "title": "vikingthe.dev API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Log out",
        "description": "Revokes every session cookie sent and expires the cookie. Idempotent: 204 with or without a live session.",
        "operationId": "logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Logged out"
          },
          "403": {
            "description": "Cross-origin write",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Session store unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "The logged-in user",
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Session store or database unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/session": {
      "get": {
        "tags": [
          "internal"
        ],
        "summary": "The session user, for server-side rendering",
        "description": "Internal listener (`:8081`) only, never routed publicly. Astro forwards the browser's `Cookie` header.",
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "401": {
            "description": "No valid session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Session store or database unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "sha"
        ],
        "properties": {
          "sha": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ]
      },
      "LogoutRequest": {
        "type": "object",
        "description": "The contract's `{}` body; the handler ignores it, so logout stays idempotent.",
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "instance": {
            "type": [
              "string",
              "null"
            ],
            "description": "`urn:uuid:<request-id>`, the same ID as the `X-Request-Id` header."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ProblemType"
          }
        }
      },
      "ProblemType": {
        "type": "string",
        "enum": [
          "https://vikingthe.dev/problems/unauthenticated",
          "https://vikingthe.dev/problems/reauthentication_required",
          "https://vikingthe.dev/problems/forbidden",
          "https://vikingthe.dev/problems/not_found",
          "https://vikingthe.dev/problems/validation",
          "https://vikingthe.dev/problems/idempotency_conflict",
          "https://vikingthe.dev/problems/rate_limited",
          "https://vikingthe.dev/problems/unavailable",
          "https://vikingthe.dev/problems/internal"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "user",
          "admin"
        ]
      },
      "SessionUser": {
        "type": "object",
        "required": [
          "user",
          "role",
          "grants"
        ],
        "properties": {
          "grants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "App names the user may use, e.g. \"stash\"."
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
