# Throwaway local-development values (CLAUDE.md). Never reuse them anywhere else.
POSTGRES_USER=vikingthedev
POSTGRES_DB=vikingthedev
# Trust auth is safe only because compose.dev.yaml binds PostgreSQL to 127.0.0.1.
POSTGRES_HOST_AUTH_METHOD=trust
DATABASE_URL=postgres://vikingthedev@127.0.0.1:5432/vikingthedev
VALKEY_URL=redis://127.0.0.1:6379
# Local hosts mirror the CI stack (ADR 0002): *.vikingthe.test.
COOKIE_DOMAIN=vikingthe.test
ALLOWED_ORIGINS=https://vikingthe.test,https://canary.vikingthe.test
# Nothing sets it locally, so requests run without a client IP (ADR 0003).
CLIENT_IP_HEADER=CF-Connecting-IP
