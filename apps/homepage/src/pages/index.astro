---
import Layout from "@vikingthedev/ui/Layout.astro";
import SessionGreeting from "@/components/SessionGreeting.astro";
---

<Layout title="vikingthe.dev">
  <main>
    <h1>vikingthe.dev</h1>
    <p>Under construction.</p>
    <p class="session">
      <SessionGreeting server:defer>
        <span slot="fallback"></span>
      </SessionGreeting>
    </p>
    <a href="/account">Account</a>
  </main>
</Layout>

<style>
  /* Fixed size, so swapping the fallback for the island shifts nothing (homepage spec). */
  .session {
    block-size: 1.5em;
  }
</style>
