---
import { PLATFORM_URL } from "astro:env/server";
import Layout from "@vikingthedev/ui/Layout.astro";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
const user = Astro.locals.user?.user;
const canaryUrl = new URL(PLATFORM_URL);
canaryUrl.hostname = `canary.${canaryUrl.hostname}`;
---

<Layout title="Account · vikingthe.dev">
  <main>
    <h1>Account</h1>
    {user ? <p>Logged in as {user.display_name}.</p> : <p>Not logged in.</p>}
    <nav>
      <a href="/">Home</a>
      <a href={canaryUrl.href}>Canary</a>
    </nav>
  </main>
</Layout>
