---
import { PLATFORM_URL } from "astro:env/server";
import Layout from "@vikingthedev/ui/Layout.astro";
import LogoutButton from "@/components/LogoutButton.svelte";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");
const user = Astro.locals.user?.user;
const homepageUrl = new URL(PLATFORM_URL);
---

<Layout title="canary · vikingthe.dev">
  <main>
    <h1>canary</h1>
    <p>{user ? user.display_name : "anonymous"}</p>
    {user && <LogoutButton client:idle />}
    <a href={homepageUrl.href}>vikingthe.dev</a>
  </main>
</Layout>
