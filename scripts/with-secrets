#!/usr/bin/env bash
# For humans only: Claude is denied this script in .claude/settings.json.
set -euo pipefail

secrets_file="${HOME}/.config/vikingthedev/secrets.env"

if [[ "$(stat -c %a "$secrets_file")" != "600" ]]; then
  echo "refusing: $secrets_file must be mode 600" >&2
  exit 1
fi

set -a
# shellcheck source=/dev/null
source "$secrets_file"
set +a

exec "$@"
